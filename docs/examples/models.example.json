{
  "schema_version": 1,
  "default_model_id": "main",
  "providers": {
    "gateway": {
      "kind": "openai_compatible",
      "base_url": "https://example.invalid/v1",
      "api_key": "<your-api-key>"
    }
  },
  "models": {
    "main": {
      "provider_id": "gateway",
      "model": "<your-model-name>",
      "api": "chat_completions",
      "request": {
        "timeout_seconds": 300,
        "stream_chunk_timeout_seconds": 600,
        "tool_stream": true
      },
      "profile": {
        "image_inputs": false,
        "memory_output": "text",
        "prompt_cache": {
          "protocol": "openai",
          "retentions": ["in_memory", "24h"]
        }
      }
    }
  }
}
