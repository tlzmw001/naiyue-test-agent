    "max_pending_messages": 16,
    "max_parts": 16384,
    "preview_chars": 512,
    "detail_chars": 16384,
    "cursor_seconds": 3600,
    "body_depth": 64
  },
  "observation_limits": {
    "queue_records": 256,
    "queue_bytes": 524288,
    "record_bytes": 32768,
    "batch_records": 64,
    "flush_seconds": 0.05,
