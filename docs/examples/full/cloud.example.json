    "page_size": 100,
    "max_pages": 100
  },
  "templates": {},
  "max_active_environments": 2,
  "max_retained_environments": 10,
  "idle_stop_seconds": 1800.0,
  "resource_limits": {
    "maintenance_interval_seconds": 30.0,
    "task_batch_size": 100,
    "scan_max_entries": 100000,
    "scan_max_depth": 64,
    "scan_timeout_seconds": 2.0,
    "cleanup_timeout_seconds": 30.0,
    "scan_cache_seconds": 5.0,
    "min_free_bytes": 268435456
