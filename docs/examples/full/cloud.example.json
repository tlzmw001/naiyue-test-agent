  "delete_drain_timeout_seconds": 30.0,
  "task_cpu": 2,
  "task_memory": "2Gi",
  "input_limits": {
    "max_file_bytes": 67108864,
    "max_input_bytes": 134217728,
    "max_archive_bytes": 167772160,
    "max_files": 4096,
    "max_metadata_bytes": 1048576,
    "io_bytes": 262144,
    "max_pending": 8,
    "max_cache_bytes": 536870912,
    "gzip_level": 3,
    "upload_timeout_seconds": 120.0,
    "chunk_bytes": 8388608,
    "max_segments": 4096,
    "staging_ttl_seconds": 86400.0,
    "sweep_interval_seconds": 60.0,
    "git_executable": "git",
    "git_timeout_seconds": 30.0,
    "max_discovery_entries": 100000
  },
  "control_io_timeout_seconds": 15.0,
  "control_receive_timeout_seconds": 60.0,
  "runner_permissions": {
    "mode": "NoAsk",
    "deny": [],
    "allow": [
      {
        "tool": "*",
        "args": {}
      }
    ]
  },
  "tool_environment": {
    "values": {},
    "path_prepend": [],
    "unset_env": []
  },
  "subagents": [],
