    "max_result_bytes": 268435456,
    "max_results": 64,
    "result_lease_seconds": 300.0,
    "max_result_leases": 128,
    "git_executable": "git",
    "git_timeout_seconds": 30.0
  },
  "model_proxy": {
    "config_path": "/srv/nyt/private/models.json",
    "upstreams": {},
    "max_request_bytes": 33554432,
